# Optional. Without this, the "Ask AI tutor" button falls back to a message
# explaining the AI tutor isn't connected yet; built-in hints always work.
OPENAI_API_KEY=

# Required for progress/streak tracking to work. Free Turso (hosted SQLite)
# database — see https://turso.tech. Without these, /api/progress and
# /api/streak return 500s and progress won't save.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
